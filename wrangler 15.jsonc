{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spoors",
  "main": "worker.js",
  "compatibility_date": "2026-08-04",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/assets/*.mp4", "/assets/*.webm", "/assets/*.mov"],
    "not_found_handling": "single-page-application"
  }
}
