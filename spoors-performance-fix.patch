+
+  // Stop spending decode/GPU time on the hero once it is off-screen. The
+  // previous behavior kept the looping background video running for the
+  // entire page visit, which can steal frame budget while the user scrolls.
+  useEffect(() => {
+    const video = videoRef.current;
+    if (!video || !("IntersectionObserver" in window)) return undefined;
+
+    let inView = true;
+
+    const syncPlayback = () => {
+      if (!inView || document.visibilityState !== "visible") {
+        video.pause();
+        return;
+      }
+
+      const attempt = video.play();
+      attempt?.catch?.(() => {});
+    };
+
+    const observer = new IntersectionObserver(
+      ([entry]) => {
+        inView = Boolean(entry?.isIntersecting);
+        syncPlayback();
+      },
+      {
+        rootMargin: "160px 0px",
+        threshold: 0.01,
+      }
+    );
+
+    observer.observe(video);
+    document.addEventListener("visibilitychange", syncPlayback);
+
+    return () => {
+      observer.disconnect();
+      document.removeEventListener("visibilitychange", syncPlayback);
+    };
+  }, [viewport, src, mobileSrc]);

   const activeSrc = viewport === "mobile" ? mobileSrc : src;
   if (!viewport || !activeSrc) return null;
